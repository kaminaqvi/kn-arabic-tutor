   "ur": "اے ہمارے رب، تیرے ہی لیے سب تعریف ہے"
  },
  {
   "id": "q-112-1",
   "kind": "ayah",
   "quran": "112:1",
   "ar": "",
   "tr": "qul huwa llahu ahad",
   "en": "Say: He is Allah, the One.",
   "ur": "کہہ دیجیے: وہ اللہ ایک ہے۔"
  },
  {
   "id": "q-112-2",
   "kind": "ayah",
   "quran": "112:2",
   "ar": "",
   "tr": "allahu s-samad",
   "en": "Allah, the Eternal Refuge.",
   "ur": "اللہ بے نیاز ہے۔"
  },
  {
   "id": "q-112-3",
   "kind": "ayah",
   "quran": "112:3",
   "ar": "",
   "tr": "lam yalid wa lam yulad",
   "en": "He neither begets nor is born.",
   "ur": "نہ اس کی کوئی اولاد ہے اور نہ وہ کسی کی اولاد ہے۔"
  },
  {
